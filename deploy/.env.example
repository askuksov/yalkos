# Optional local overrides for `make dev` / docker compose.
# Copy this file to deploy/.env and change what you need. Without it the
# defaults below are used.

# Password of the local PostgreSQL. It is stored in the data volume when the
# database is first created; changing it later requires changing it in the DB.
YALKOS_DB_PASSWORD=yalkos

# YALKOS_PORT=8080       # Go server
# YALKOS_WEB_PORT=5173   # Vite dev server
# YALKOS_DB_PORT=54320   # PostgreSQL, published on 127.0.0.1 only
# LOG_LEVEL=info         # debug | info | warn | error
