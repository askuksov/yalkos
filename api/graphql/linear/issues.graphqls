"An issue."
type Issue {
  id: ID!
  trashed: Boolean
  "Always an empty list."
  reactionData: JSONObject!
  "Ids of the issue's labels, its type included."
  labelIds: [String!]!
  integrationSourceType: IntegrationService
  url: String!
  "KEY-N with the team's current key."
  identifier: String!
  priorityLabel: String!
  previousIdentifiers: [String!]!
  reactions: [Reaction!]!
  customerTicketCount: Int!
  sharedAccess: IssueSharedAccess!
  "Suggested git branch name: identifier and title."
  branchName: String!
  delegate: User
  botActor: ActorBot
  sourceComment: Comment
  cycle: Cycle
  dueDate: TimelessDate
  estimate: Float
  syncedWith: [ExternalEntityInfo!]
  externalUserCreator: ExternalUser
  asksExternalUserRequester: ExternalUser
  asksRequester: User
  description: String
  title: String!
  number: Float!
  lastAppliedTemplate: Template
  updatedAt: DateTime!
  boardOrder: Float!
  sortOrder: Float!
  prioritySortOrder: Float!
  "Order among the parent's sub-issues; null without a parent."
  subIssueSortOrder: Float
  parent: Issue
  "0 no priority, 1 urgent, 2 high, 3 medium, 4 low."
  priority: Float!
  projectMilestone: ProjectMilestone
  project: Project
  recurringIssueTemplate: Template
  team: Team!
  archivedAt: DateTime
  createdAt: DateTime!
  startedTriageAt: DateTime
  triagedAt: DateTime
  addedToCycleAt: DateTime
  addedToProjectAt: DateTime
  addedToTeamAt: DateTime
  autoArchivedAt: DateTime
  autoClosedAt: DateTime
  canceledAt: DateTime
  completedAt: DateTime
  startedAt: DateTime
  slaStartedAt: DateTime
  slaBreachesAt: DateTime
  slaHighRiskAt: DateTime
  slaMediumRiskAt: DateTime
  snoozedUntilAt: DateTime
  slaType: String
  assignee: User
  creator: User
  snoozedBy: User
  favorite: Favorite
  state: WorkflowState!
  inheritsSharedAccess: Boolean!
  "Sub-issues, archived teams included."
  children(after: String, before: String, filter: IssueFilter, first: Int, includeArchived: Boolean, last: Int, orderBy: PaginationOrderBy): IssueConnection!
  "Always empty."
  relations(after: String, before: String, first: Int, includeArchived: Boolean, last: Int, orderBy: PaginationOrderBy): IssueRelationConnection!
  "Files uploaded to the issue."
  attachments(after: String, before: String, filter: AttachmentFilter, first: Int, includeArchived: Boolean, last: Int, orderBy: PaginationOrderBy): AttachmentConnection!
}

type IssueConnection {
  nodes: [Issue!]!
  edges: [IssueEdge!]!
  pageInfo: PageInfo!
}

type IssueEdge {
  node: Issue!
  cursor: String!
}

"Issue filter; conditions are AND-ed, relation filters match by id sets."
input IssueFilter {
  and: [IssueFilter!]
  or: [IssueFilter!]
  "Issue UUIDs."
  id: IDComparator
  number: NumberComparator
  title: StringComparator
  description: NullableStringComparator
  "0 = no priority; null: true matches nothing."
  priority: NullableNumberComparator
  createdAt: DateComparator
  updatedAt: DateComparator
  completedAt: NullableDateComparator
  canceledAt: NullableDateComparator
  dueDate: NullableTimelessDateComparator
  assignee: NullableUserFilter
  creator: NullableUserFilter
  state: WorkflowStateFilter
  team: TeamFilter
  parent: NullableIssueFilter
}

input NullableIssueFilter {
  "Issue UUIDs."
  id: IDComparator
  null: Boolean
}

"One element with one key."
input IssueSortInput {
  priority: PrioritySort
  createdAt: CreatedAtSort
  updatedAt: UpdatedAtSort
  dueDate: DueDateSort
  manual: ManualSort
}

"Urgent first, no priority last."
input PrioritySort {
  nulls: PaginationNulls
  order: PaginationSortOrder
  noPriorityFirst: Boolean
}

input CreatedAtSort {
  nulls: PaginationNulls
  order: PaginationSortOrder
}

input UpdatedAtSort {
  nulls: PaginationNulls
  order: PaginationSortOrder
}

"Soonest first, no due date last."
input DueDateSort {
  nulls: PaginationNulls
  order: PaginationSortOrder
}

"Board order."
input ManualSort {
  nulls: PaginationNulls
  order: PaginationSortOrder
}

"Declared for client compatibility; issues here have no relations."
type IssueRelation {
  updatedAt: DateTime!
  issue: Issue!
  relatedIssue: Issue!
  archivedAt: DateTime
  createdAt: DateTime!
  type: String!
  id: ID!
}

type IssueRelationConnection {
  nodes: [IssueRelation!]!
  edges: [IssueRelationEdge!]!
  pageInfo: PageInfo!
}

type IssueRelationEdge {
  node: IssueRelation!
  cursor: String!
}

"A file uploaded to an issue (read only)."
type Attachment {
  subtitle: String
  "File name."
  title: String!
  source: JSONObject
  "size and contentType."
  metadata: JSONObject!
  "Download URL."
  url: String!
  bodyData: String
  creator: User
  issue: Issue!
  originalIssue: Issue
  updatedAt: DateTime!
  externalUserCreator: ExternalUser
  sourceType: String
  archivedAt: DateTime
  createdAt: DateTime!
  id: ID!
  groupBySource: Boolean!
}

type AttachmentConnection {
  nodes: [Attachment!]!
  edges: [AttachmentEdge!]!
  pageInfo: PageInfo!
}

type AttachmentEdge {
  node: Attachment!
  cursor: String!
}

input AttachmentFilter {
  id: IDComparator
  title: StringComparator
  createdAt: DateComparator
}

"An issue found by searchIssues: the issue's fields and metadata."
type IssueSearchResult {
  id: ID!
  trashed: Boolean
  "Always an empty list."
  reactionData: JSONObject!
  "Ids of the issue's labels, its type included."
  labelIds: [String!]!
  integrationSourceType: IntegrationService
  url: String!
  "KEY-N with the team's current key."
  identifier: String!
  priorityLabel: String!
  previousIdentifiers: [String!]!
  reactions: [Reaction!]!
  customerTicketCount: Int!
  sharedAccess: IssueSharedAccess!
  "Suggested git branch name: identifier and title."
  branchName: String!
  delegate: User
  botActor: ActorBot
  sourceComment: Comment
  cycle: Cycle
  dueDate: TimelessDate
  estimate: Float
  syncedWith: [ExternalEntityInfo!]
  externalUserCreator: ExternalUser
  asksExternalUserRequester: ExternalUser
  asksRequester: User
  description: String
  title: String!
  number: Float!
  lastAppliedTemplate: Template
  updatedAt: DateTime!
  boardOrder: Float!
  sortOrder: Float!
  prioritySortOrder: Float!
  "Order among the parent's sub-issues; null without a parent."
  subIssueSortOrder: Float
  parent: Issue
  "0 no priority, 1 urgent, 2 high, 3 medium, 4 low."
  priority: Float!
  projectMilestone: ProjectMilestone
  project: Project
  recurringIssueTemplate: Template
  team: Team!
  archivedAt: DateTime
  createdAt: DateTime!
  startedTriageAt: DateTime
  triagedAt: DateTime
  addedToCycleAt: DateTime
  addedToProjectAt: DateTime
  addedToTeamAt: DateTime
  autoArchivedAt: DateTime
  autoClosedAt: DateTime
  canceledAt: DateTime
  completedAt: DateTime
  startedAt: DateTime
  slaStartedAt: DateTime
  slaBreachesAt: DateTime
  slaHighRiskAt: DateTime
  slaMediumRiskAt: DateTime
  snoozedUntilAt: DateTime
  slaType: String
  assignee: User
  creator: User
  snoozedBy: User
  favorite: Favorite
  state: WorkflowState!
  inheritsSharedAccess: Boolean!
  "Always an empty object."
  metadata: JSONObject!
}

type IssueSearchPayload {
  "Declared for client compatibility; always empty."
  archivePayload: ArchiveResponse!
  "Number of all matches."
  totalCount: Float!
  nodes: [IssueSearchResult!]!
  pageInfo: PageInfo!
}

type ArchiveResponse {
  archive: String!
  totalCount: Float!
  databaseVersion: Float!
  includesDependencies: [String!]!
}
